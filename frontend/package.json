    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@playwright/test": "^1.58.2",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@vitejs/plugin-vue": "^5.0.0",
    "chai": "^6.2.2",
    "mocha": "^11.7.5",
    "tsx": "^4.21.0",
