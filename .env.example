# Copy this to .env and fill in values before running docker-compose up

# Database
POSTGRES_PASSWORD=changeme

# Flask secrets (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=changeme
JWT_SECRET_KEY=changeme

# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public URLs — set to wherever the app is accessible
# FRONTEND_URL is used for CORS and OAuth redirect whitelisting
FRONTEND_URL=http://localhost
BACKEND_URL=http://localhost
